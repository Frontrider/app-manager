#--------------------------------------------------------------------
# LDAP authentication (requires the PHP LDAP extension)
#--------------------------------------------------------------------
# LLDAP: bind directly as uid=<entered username>,<userBaseDN> using
# the entered password, then read that user's memberOf attribute.
# No service-account credentials are required or stored.
# ldap.uri = 'ldap://lldap:3890'
# ldap.userBaseDN = 'ou=people,dc=example,dc=com'
# ldap.groupBaseDN = 'ou=groups,dc=example,dc=com'
# ldap.userAttribute = 'uid'
# ldap.adminGroup = 'lldap_admin'
# ldap.startTLS = false
# ldap.timeout = 5
# ldap.sessionLifetime = 3600
# LLDAP's default listener has no StartTLS; keep it on an isolated network.
# Use ldaps:// or enable StartTLS if supported by the configured provider.
# Serve this application over HTTPS in production.
